msgid "World clock"
msgstr "Wereldklok"

msgid "Base conversion"
msgstr "Basisconversie"

msgid "Hash &amp; UUID"
msgstr "Hash en UUID"

msgid "Encode &amp; decode"
msgstr "Coderen en decoderen"

msgid "JSON &amp; Regex"
