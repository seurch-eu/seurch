# Both defaults fail closed: DEBUG defaults to False, and with DEBUG=False a
# real SECRET_KEY is REQUIRED (the app refuses to boot without one). Generate
# a production key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://search:search@localhost:5432/search

# Shared cache backing the rate-limit counters below (and the API throttles).
# Defaults to a database cache (table "django_cache", created by
# `make migrate` / the Docker entrypoint via `manage.py createcachetable`),
# so limits hold across gunicorn workers and survive restarts. Point it at
# Redis instead with e.g. CACHE_URL=rediscache://127.0.0.1:6379/1
# CACHE_URL=dbcache://django_cache

# Brute-force protection. A username that fails to sign in LOGIN_THROTTLE_LIMIT
# times inside LOGIN_THROTTLE_WINDOW seconds is locked out for the rest of the
# window (the same budget applies per client IP at 10x the limit, so one
# machine can't spray many accounts). Password-reset emails are capped per IP
# at PASSWORD_RESET_THROTTLE_LIMIT per PASSWORD_RESET_THROTTLE_WINDOW seconds.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_WINDOW=900
PASSWORD_RESET_THROTTLE_LIMIT=5
PASSWORD_RESET_THROTTLE_WINDOW=3600

# Per-IP budget for the public (unauthenticated) OpenSearch endpoints
# (/opensearch-suggest/ hits Brave's paid suggest API). The default leaves a
# browser firing a request per keystroke plenty of room while stopping
# anonymous quota draining.
OPENSEARCH_THROTTLE_LIMIT=60
OPENSEARCH_THROTTLE_WINDOW=60

# Privacy: log the raw search-query text in the app log? Defaults to the DEBUG
# value, i.e. verbose while developing, OFF in production (queries are
# personal data and container logs are retained). When off, log lines carry
# only the query length.
# LOG_SEARCH_QUERIES=False

# Brave Search API, get a free key at https://brave.com/search/api/
BRAVE_API_KEY=

# Brave Suggest (autocomplete) API, separate subscription/key from BRAVE_API_KEY,
# get one at https://brave.com/search/api/
BRAVE_SUGGEST_API_KEY=

# Mojeek Search API, get a free key at https://www.mojeek.com/services/search/api/
MOJEEK_API_KEY=

# Marginalia Search API, no signup required; the "public" key works out of the box
# (rate-limited to ~1 request / 5 s). For a higher quota, request a key at
# https://about.marginalia-search.com/article/api/
MARGINALIA_API_KEY=public

# Staan, the European web index built by Qwant and Ecosia's joint venture
# (European Search Perspective). Web results only, and it serves the first four
# pages of a search (its API caps pagination at an offset of 30). Get a key at
# https://staan.ai/ (1,000 free requests a month, then from EUR 1 per 1,000).
STAAN_API_KEY=

# TheTVDB v4 API, powers the film/TV knowledge card. Get a key at
# https://www.thetvdb.com/dashboard/account/apikey. TheTVDB licenses its API two
# ways (https://thetvdb.com/api-information): a negotiated/commercial license
# (key only), or a user-supported key, which additionally requires the end
# user's own TheTVDB subscriber PIN below. Use whichever model your deployment
# is actually licensed under; attribution is shown on the card as required.
THETVDB_API_KEY=
# Subscriber PIN, only for user-supported keys (leave empty for licensed keys).
THETVDB_PIN=

# TripAdvisor Terra Partner API (https://docs.terra.tripadvisor.com), sent as
# the X-API-Key header. The card is built from the catalog endpoints, which
# are served without a partner allowlist or geofencing; it replaces the
# retired Content API (api.content.tripadvisor.com), whose keys now 403.
TRIPADVISOR_API_KEY=

# Stack Exchange API, no signup required for the default quota (10,000
# requests/day shared across anonymous callers). For a higher quota, register
# an app at https://stackapps.com/apps/oauth/register and set its key here.
STACKEXCHANGE_API_KEY=

# Pixabay API, free image provider for the Images tab. When set, Pixabay results
# are blended with Brave's (and are the sole image source for the Mojeek/Marginalia
# engines). Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# World News API, news provider for the News tab. When set, its articles are
# blended with Brave's (and are the sole news source for the Mojeek/Marginalia
# engines, which have no news search of their own). Get a free key at
# https://worldnewsapi.com/
WORLDNEWS_API_KEY=

# Providers shown with a "Paid" badge in Settings → Engines, so users can see
# which ones are metered commercial APIs before switching them on. Unset uses
# the app's own list (Brave, Mojeek, Staan, World News); override it if this
# deployment is on different plans. Anything that isn't a provider key is
# ignored, so PAID_PROVIDERS=none badges nothing. Label only, it never changes
# what a user is allowed to enable.
# PAID_PROVIDERS=brave,mojeek,staan,worldnews

# LibreTranslate, powers the Translate tab. "make up" starts a local instance
# at http://localhost:5000 (see docker-compose.yml). Leave unset to disable the
# Translate tab and its setting entirely.
LIBRETRANSLATE_URL=http://localhost:5000
# Only needed if the LibreTranslate instance requires an API key (LT_API_KEYS=true).
LIBRETRANSLATE_API_KEY=
# Two-letter country code for the flag shown next to "Translate" in
# Settings → Engine → Data sources (the instance can be hosted anywhere).
LIBRETRANSLATE_ORIGIN_COUNTRY=fr

# Mounts /api/v1/, letting any signed-up user mint a key and pull raw search
# results through this app's API. Some upstream providers (Brave) only
# license redistributing their results to render this app's own pages to the
# human end user, not to third-party API consumers, so a deployment open to
# the public should set this to false. Leave it true for a self-hosted
# instance whose only API caller is you.
PUBLIC_API_ENABLED=true

# The /status page shows users whether each upstream provider is up, so a
# missing result reads as an outage rather than "no matches". Set this to false
# to take the page off this instance: it 404s, the footer and Settings links to
# it disappear, and the API's /api/v1/status/ endpoint (same data) goes with it.
STATUS_PAGE_ENABLED=true

# /status/health/<provider> (one per upstream: brave, mojeek, marginalia,
# staan, pixabay, sepia, worldnews, wikipedia, wikidata, thetvdb, tripadvisor,
# stackexchange, weather, currency, openstreetmap, translate) and /status/health
# (the roll-up) are that page's machine-readable siblings, for an external
# uptime monitor (phare.io, Better Stack, Uptime Kuma, …): 200 while the
# provider(s) are up, 500 as soon as one is down or the database is
# unreachable. They are public, no login (a monitor can't sign in), and work
# independently of STATUS_PAGE_ENABLED, so an instance that doesn't publish the
# page can still be monitored. Set this to false to remove them entirely.
STATUS_MONITOR_ENABLED=true

# Optional shared secret for the endpoints above, sent by the monitor as
# ?token=…, an X-Monitor-Token header, or Authorization: Bearer …. Empty (the
# default) leaves them public; anything wrong gets a 403.
STATUS_MONITOR_TOKEN=

# Which providers the /status/health roll-up covers, comma-separated provider
# slugs (as listed above) and/or group keys (engine, media, cards, instant,
# maps, translate). Empty (the default) watches every configured provider;
# narrow it, e.g. to "engine", so an outage of some optional extra doesn't page
# whoever is on call. This scopes the roll-up only, each /status/health/<provider>
# endpoint always answers for its own provider. A provider that has never been
# observed is never counted as down.
STATUS_MONITOR_PROVIDERS=

# Extra links shown in the site footer, "Label=URL" pairs separated by commas.
# Use this to point at your own privacy policy, terms of use or legal notice
# (their content is jurisdiction-specific, so none ship by default). Leave
# unset to show no extra footer links.
# FOOTER_LINKS=Privacy=https://example.com/privacy,Terms=https://example.com/terms,Legal notice=https://example.com/legal

# Repository linked from the footer's "Source" link. Point this at your own
# fork if you're running a modified version.
# SOURCE_URL=https://github.com/search-project/search

# Git ref (branch/tag) and commit hash shown next to the copyright in the
# footer, so a deployment can be traced back to the exact build. The Docker
# image sets these automatically at build time (see the Dockerfile and
# .github/workflows/docker.yml); only set them by hand for other deployment
# methods.
# GIT_REF=main
# GIT_SHA=abc1234

# Public API rate limits, applied per API key (Django REST Framework throttle
# rates, "<number>/<period>"; period is one of second/minute/hour/day). The
# burst limit shields the upstream search providers from a runaway client; the
# sustained limit caps daily volume. Raise them for a trusted deployment.
API_THROTTLE_BURST=60/min
API_THROTTLE_SUSTAINED=5000/day

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Email, password reset
# Development: Mailpit catches all outgoing mail at http://localhost:8025
# (Mailpit starts automatically with "make up")
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@seurch.io

# Alternatively, use the console backend to print emails to stdout instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP, replace with real values:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=secret
# DEFAULT_FROM_EMAIL=noreply@seurch.io
